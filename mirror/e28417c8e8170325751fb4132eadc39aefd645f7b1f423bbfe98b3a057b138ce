  // ─── CSS for AI chip ────────────────────────────────────────────────
  function injectCss() {
    if (STATE.cssIn) return;   // the kit knows it added its styles; no lookup of an id the build's own page never has
    STATE.cssIn = true;
    const s = document.createElement('style');
    s.id = 'fk-css';
